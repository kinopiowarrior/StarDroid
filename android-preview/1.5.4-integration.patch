+// Validation runs on the importer thread and never touches engine state.
+static int validate_hd2_sprites(const std::string& directory) {
+    return stardroid::remastered::live::configure(directory, false);
+}
+// Activation and palette changes use the same engine thread as frame().
+static int set_hd2_sprites(const std::string& directory, bool enabled) {
+    int count = 0;
+    if (enabled) count = stardroid::remastered::live::configure(directory, true);
+    else std::atomic_store(&stardroid::remastered::live::active_pack,
+                           std::shared_ptr<const stardroid::remastered::live::Pack>());
+    if (count >= 0 && g_ui) g_ui->prepare_hd2_palette();
+    return count;
