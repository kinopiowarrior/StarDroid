+// The game window and all input coordinates are logical world pixels. Only the
+// Android output target can be twice as dense. Resolve directly into its rows
+// after one UI update, preserving alpha byte order and the client's row padding.
+static void render_world_pixels(uint8_t* dst, size_t stride_bytes, unsigned width,
+                                unsigned height, double now_ms) {
+    if (!g_ui) return;
+    const int logical_width = openbw_framebuffer_width();
+    const int logical_height = openbw_framebuffer_height();
+    if (logical_width <= 0 || logical_height <= 0) return;
+    const bool doubled = dst && uint64_t(logical_width) * 2 == width &&
+                                uint64_t(logical_height) * 2 == height;
+    if (dst) {
+        const bool logical = width == unsigned(logical_width) && height == unsigned(logical_height);
+        if ((!logical && !doubled) || (doubled && uint64_t(width) * height > 16u * 1024u * 1024u))
+            throw std::runtime_error("Unexpected battlefield bitmap dimensions");
+        if (stride_bytes < size_t(width) * 4 || stride_bytes > std::numeric_limits<size_t>::max() / height)
+            throw std::runtime_error("Invalid battlefield bitmap stride");
+    }
+    g_ui->external_minimap = true;
+    g_ui->hd2_output_requested = doubled;
+    openbw_render(now_ms);
+    const uint8_t* classic = openbw_framebuffer();
+    if (!dst || !classic) return;
+    const size_t classic_pitch = size_t(logical_width) * 4;
+    if (doubled) g_ui->present_hd2(dst, stride_bytes, classic, classic_pitch);
+    else if (stride_bytes == classic_pitch) std::memcpy(dst, classic, classic_pitch * height);
+    else for (unsigned y = 0; y < height; ++y)
+        std::memcpy(dst + y * stride_bytes, classic + y * classic_pitch, classic_pitch);
+}
