+      } catch (IOException | RuntimeException error) {
+        result = "HD2 import failed: " + error.getMessage();
+      } finally {
+        GameDataOperation.finish(lease, result);
+      }
+      final String message = result;
+      runOnUiThread(() -> {
+        if (isDestroyed()) return;
+        notice = message;
+        showHome();
+      });
+    });
