+  private void applyHd2Selection() {
+    // Serialize activation with generation replacement. No file access occurs in the draw loop.
+    synchronized (Hd2SpritePack.class) {
+      File root = activity.hd2SpriteRoot();
+      Hd2SpritePack.Selection selected = Hd2SpritePack.selection(root);
+      String path = selected.enabled ? selected.directory.getAbsolutePath() : "";
+      if (path.equals(activeHd2Directory)) return;
+      int loaded = NativeBridge.setHd2Sprites(path, selected.enabled);
+      if (selected.enabled && loaded <= 0) {
+        NativeBridge.setHd2Sprites("", false);
+        try { Hd2SpritePack.setEnabled(root, false); }
+        catch (IOException error) { AppDiagnostics.recordFailure("HD2 sprite selection", error); }
+        activeHd2Directory = "";
+        activity.hd2Unavailable();
+        return;
+      }
+      activeHd2Directory = path;
+    }
+  }
