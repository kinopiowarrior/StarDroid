+// Ordered palette writes also retire any HD2 samples under the same pixel.
+inline void put_indexed(uint8_t* dest, uint8_t value) {
+#ifdef STARDROID_HD2_RUNTIME
+    if (auto* plane = stardroid::remastered::live::observing) plane->retire(dest);
+#endif
+    *dest = value;
+}
+inline void fill_indexed(uint8_t* dest, int value, size_t count) {
+#ifdef STARDROID_HD2_RUNTIME
+    if (auto* plane = stardroid::remastered::live::observing) plane->retire(dest, count);
+#endif
+    std::memset(dest, value, count);
+}
