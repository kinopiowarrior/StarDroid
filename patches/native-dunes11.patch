+    void ai_random_suicide(int owner) {
+        // send_suicide(1), used by SuiR in Dunes of Shakuras, is a per-unit
+        // nearest-enemy order. It is not a strategic wave aimed at a base.
+        // Do not use the town's attackers set: a later SuiR must also be able
+        // to send surviving units again after their first target is gone.
+        for(auto* u:ptr(st.player_units[owner])) {
+            if(unit_dying(u)||!u_completed(u)||!u->sprite||ut_building(u)||ut_turret(u)
+                ||u_loaded(u)||us_hidden(u)||unit_is_fighter(u)||unit_is_disabled(u)
+                ||u_order_not_interruptible(u)||u_iscript_nobrk(u)||ai_casting(u))continue;
+            unit_t* target=nullptr;int distance=0x7fffffff;
+            for(int p=0;p<8;++p)if(p!=owner&&!st.alliances[owner][p])
+                for(auto* other:ptr(st.player_units[p])) {
+                    if(unit_dying(other)||!other->sprite||ut_turret(other)
+                        ||!unit_can_attack_target(u,other)||!is_reachable(u,other->sprite->position))continue;
+                    int d=units_distance(u,other);
+                    if(d<distance){target=other;distance=d;}
+                }
+            if(!target)continue;
+            // Preserve an attack already in progress instead of restarting its
+            // animation every time a preserved scenario trigger runs SuiR.
+            if(u->order_target.unit==target&&u->order_type==u->unit_type->attack_unit)continue;
+            issue_order(u,false,u->unit_type->attack_unit,{target->sprite->position,target});
+            ++towns[owner].orders;
+        }
+    }
